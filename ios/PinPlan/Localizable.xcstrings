    "A review link needs cloud sync and the Northpin server address (the client opens it on your web app). The PDF works without them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un enlace de revisión necesita la sincronización en la nube y la dirección del servidor de Northpin (el cliente lo abre en tu app web). El PDF funciona sin ellos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link do akceptacji wymaga synchronizacji z chmurą i adresu serwera Northpin (klient otwiera go w Twojej wersji webowej). PDF działa i bez tego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link de revisão precisa da sincronização na nuvem e do endereço do servidor Northpin (o cliente abre no seu app web). O PDF funciona sem eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для ссылки на согласование нужны облачная синхронизация и адрес сервера Northpin (клиент открывает её в вашей веб-версии). PDF работает и без них."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для посилання на погодження потрібні хмарна синхронізація й адреса сервера Northpin (клієнт відкриває його у вашій веб-версії). PDF працює і без них."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link xem duyệt cần đồng bộ đám mây và địa chỉ máy chủ Northpin (khách hàng mở link trên ứng dụng web của bạn). PDF vẫn dùng được mà không cần chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审阅链接需要云同步和 Northpin 服务器地址（客户在你的网页版中打开）。PDF 不需要这些也能用。"
          }
        }
      }
    },
