    "Markup is added to catalog, product and cable prices. A price you type on a line is used as is." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El margen se suma a los precios del catálogo, de productos y de cable. Un precio que escribas en una línea se usa tal cual."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzut dolicza się do cen z katalogu, produktów i kabli. Cena wpisana w pozycji jest używana bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A margem é somada aos preços do catálogo, dos produtos e dos cabos. Um preço digitado na linha é usado como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наценка добавляется к ценам каталога, товаров и кабеля. Цена, введённая в строке, используется как есть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Націнка додається до цін каталогу, товарів і кабелю. Ціна, введена в рядку, використовується як є."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lợi nhuận cộng thêm được tính vào giá danh mục, sản phẩm và cáp. Giá bạn tự nhập trên một dòng được giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加价会加到目录、产品和线缆价格上。你在行中输入的价格按原样使用。"
          }
        }
      }
    },
