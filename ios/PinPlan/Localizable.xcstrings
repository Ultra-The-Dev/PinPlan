    "Saves the items and which ones need a photo — not ticks, photos, assignees or due dates — so you can start this checklist on any job." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda los elementos y cuáles requieren foto, no las marcas, fotos, responsables ni fechas límite, para que puedas empezar esta lista de verificación en cualquier obra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje pozycje i to, które wymagają zdjęcia — bez odhaczeń, zdjęć, osób przypisanych i terminów — aby można było rozpocząć tę listę kontrolną w dowolnym zleceniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva os itens e quais precisam de foto — não as marcações, fotos, responsáveis ou prazos — para você iniciar este checklist em qualquer obra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняются пункты и требование фото — без отметок, фото, исполнителей и сроков, — чтобы начать этот чек-лист на любом объекте."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігаються пункти й вимога фото — без позначок, фото, виконавців і термінів, — щоб почати цей чек-лист на будь-якому об'єкті."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu các mục và mục nào cần ảnh — không lưu dấu tích, ảnh, người nhận hay hạn — để bạn bắt đầu danh sách kiểm tra này ở bất kỳ công trình nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存检查项以及哪些项需要照片——不保存勾选、照片、负责人或截止日期——这样你可以在任何工程中使用这份检查清单。"
          }
        }
      }
    },
