    "Changes from other devices still come in. Yours go up once your company's subscription is active again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de otros dispositivos siguen llegando. Los tuyos se suben cuando la suscripción de tu empresa vuelva a estar activa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany z innych urządzeń nadal docierają. Twoje zostaną wysłane, gdy subskrypcja firmy znów będzie aktywna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações de outros aparelhos continuam chegando. As suas sobem quando a assinatura da empresa estiver ativa de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения с других устройств по-прежнему приходят. Ваши отправятся, когда подписка компании снова станет активной."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміни з інших пристроїв і далі надходять. Ваші відправляться, коли підписка компанії знову стане активною."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi từ thiết bị khác vẫn được nhận về. Thay đổi của bạn sẽ được gửi lên khi gói đăng ký của công ty hoạt động trở lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他设备的更改仍会同步过来。你的更改会在公司订阅恢复后上传。"
          }
        }
      }
    },
