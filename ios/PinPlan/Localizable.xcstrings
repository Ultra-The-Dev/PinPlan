        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: wycena zatwierdzona — zlecenie zatwierdzone"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aprovou o orçamento — obra aprovada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: смета утверждена — объект утверждён"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: кошторис затверджено — об'єкт затверджено"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã duyệt báo giá — công trình đã được duyệt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
