        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta folha veio de uma foto ou escaneamento, então o tamanho do papel é desconhecido. Em vez disso, trace uma linha sobre uma cota conhecida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот лист получен из фото или скана, поэтому размер бумаги неизвестен. Лучше проведите линию по известному размеру."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей аркуш отримано з фото або скану, тому розмір паперу невідомий. Краще проведіть лінію по відомому розміру."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tờ này lấy từ ảnh hoặc bản quét, nên không biết khổ giấy. Hãy vẽ một đường lên kích thước đã biết."
          }
        },
        "zh-Hans" : {
