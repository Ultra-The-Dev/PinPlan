    "Cable is rounded up to full boxes and HDMI to stock lengths. Costs are your prices, before markup." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cable se redondea a cajas completas y el HDMI a largos estándar. Los costos son tus precios, antes del margen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabel jest zaokrąglany do pełnych kartonów, HDMI do standardowych długości. Koszty według Twoich cen, bez narzutu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cabo é arredondado para caixas inteiras e o HDMI para comprimentos de estoque. Os custos são seus preços, antes da margem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кабель округляется до целых бухт, HDMI — до стандартных длин. Стоимость — по вашим ценам, без наценки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кабель округлюється до цілих бухт, HDMI — до стандартних довжин. Вартість — за вашими цінами, без націнки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cáp được làm tròn lên theo thùng, HDMI theo độ dài có sẵn. Chi phí là giá của bạn, chưa cộng lợi nhuận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线缆按整箱向上取整，HDMI 按库存长度取整。成本为你的价格，未含加价。"
          }
        }
      }
    },
