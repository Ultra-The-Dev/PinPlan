    "Jobs that already use it keep it; it just stops appearing in pickers" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las obras que ya lo usan lo conservan; solo deja de aparecer en las listas para elegir"
          }
        },
        "pl" : {
          "stringUnit" : {
