          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте объект, добавьте планы (PDF, фото или сканер документов), затем касаниями размещайте устройства, кабельные трассы и щиты."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створіть об'єкт, додайте плани (PDF, фото або сканер документів), потім дотиками розміщуйте пристрої, кабельні траси й щити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
