          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, aby zlecenia były zgodne na iPhonie, iPadzie i w wersji webowej. Tutaj też zresetujesz hasło i usuniesz konto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para manter as obras iguais no iPhone, iPad e na versão web. A redefinição de senha e a exclusão da conta também ficam aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, чтобы объекты совпадали на iPhone, iPad и в веб-версии. Здесь же сброс пароля и удаление аккаунта."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увійдіть, щоб об'єкти збігалися на iPhone, iPad і у веб-версії. Тут же скидання пароля й видалення акаунта."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập để công trình luôn khớp giữa iPhone, iPad và bản web. Đặt lại mật khẩu và xóa tài khoản cũng ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后，工程会在 iPhone、iPad 和网页版之间保持同步。重置密码和删除账户也在这里。"
          }
        }
      }
