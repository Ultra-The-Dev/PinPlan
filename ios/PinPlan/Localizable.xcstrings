    "“%@” is now under New checklist on every job. Rename or delete it in Settings → Checklist templates." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ahora aparece en Nueva lista de verificación en cada obra. Cámbiale el nombre o elimínala en Ajustes → Plantillas de listas de verificación."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” jest teraz w Nowa lista kontrolna w każdym zleceniu. Zmień nazwę lub usuń szablon w Ustawienia → Szablony list kontrolnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” agora está em Novo checklist em todas as obras. Renomeie ou exclua em Ajustes → Modelos de checklist."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» теперь есть в «Новом чек-листе» на каждом объекте. Переименовать или удалить его можно в Настройки → Шаблоны чек-листов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» тепер є в «Новому чек-листі» на кожному об'єкті. Перейменувати або видалити його можна в Налаштування → Шаблони чек-листів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” giờ đã có trong Danh sách kiểm tra mới ở mọi công trình. Đổi tên hoặc xóa trong Cài đặt → Mẫu danh sách kiểm tra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”现在已出现在每个工程的“新建检查清单”中。可在 设置 → 检查清单模板 中重命名或删除。"
          }
        }
      }
