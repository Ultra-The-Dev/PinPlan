    "Terms of service" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия использования"
          }
        }
      }
    },
    "Terms of Service" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия использования"
          }
        }
      }
    },
    "Test result" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Результат проверки"
          }
        }
      }
    },
    "Text" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текст"
          }
        }
      }
    },
    "That address isn't a PinPlan server (or it needs the latest version deployed)." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По этому адресу нет сервера PinPlan (или на нём нужна последняя версия)."
          }
        }
      }
    },
    "That code isn't valid: it may be mistyped, already used, expired or cancelled. Ask for a new one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код недействителен: возможно, он введён с ошибкой, уже использован, истёк или отменён. Попросите новый."
          }
        }
      }
    },
    "That device is gone" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этого устройства больше нет"
          }
        }
      }
    },
    "That file isn't a PinPlan backup." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл не является резервной копией PinPlan."
          }
        }
      }
    },
    "That file was deleted" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот файл удалён"
          }
        }
      }
    },
    "That link can't be opened" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эту ссылку не открыть"
          }
        }
      }
    },
    "That PDF couldn't be opened." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось открыть этот PDF."
          }
        }
      }
    },
    "That PDF is password-protected. Unlock it and try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот PDF защищён паролем. Снимите защиту и попробуйте ещё раз."
          }
        }
      }
    },
    "That photo was deleted" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это фото удалено"
          }
        }
      }
    },
    "That PinPlan server gave a cloud address that isn't secure (https), so it wasn't used." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот сервер PinPlan передал небезопасный адрес облака (не https), поэтому он не использован."
          }
        }
      }
    },
    "That plan was deleted" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот план удалён"
          }
        }
      }
    },
    "That's a different account. Sign in again with the account you want to delete." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это другой аккаунт. Войдите снова в тот аккаунт, который хотите удалить."
          }
        }
      }
    },
    "The account can't be deleted from this device. Sign in to PinPlan on the web and choose Settings › Account › Delete account, or contact support and we'll delete it for you." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С этого устройства аккаунт удалить нельзя. Войдите в веб-версию PinPlan и выберите Настройки › Аккаунт › Удалить аккаунт или напишите в поддержку — мы удалим его за вас."
          }
        }
      }
    },
    "The account is managed on the PinPlan website." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт управляется на сайте PinPlan."
          }
        }
      }
    },
    "The AI reader" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ИИ-чтение"
          }
        }
      }
    },
    "The client approved the quote — job approved" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиент утвердил смету — объект утверждён"
          }
        }
      }
    },
    "The client reviews the plans and price, picks options and signs online." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиент смотрит планы и цену, выбирает опции и подписывает онлайн."
          }
        }
      }
    },
    "The client sees your business details, the scope, the plans, this quote and your terms. Optional items show as add-ons they can tick." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиент увидит реквизиты компании, объём работ, планы, эту смету и ваши условия. Опции показываются как дополнения, которые можно отметить."
          }
        }
      }
    },
    "The cloud database needs the team update" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облачной базе нужно обновление для команд"
          }
        }
      }
    },
    "The cloud isn't up to date yet, so some job data doesn't sync (%@). Everything else is synced." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Облако ещё не обновлено, поэтому часть данных объектов не синхронизируется (%@). Всё остальное синхронизировано."
          }
        }
      }
    },
    "The email you sign in with" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эл. почта для входа"
          }
        }
      }
    },
    "The marked-up plans with a legend that explains every symbol — no prices — so the client can check where everything goes. They can approve the layout or tell you what to change." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размеченные планы с легендой, объясняющей каждый символ, — без цен, чтобы клиент проверил, где что будет. Он может утвердить размещение или сообщить, что изменить."
          }
        }
      }
    },
    "The office checks the wording and who it goes to, then sends it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офис проверит формулировку и адресата, затем отправит."
          }
        }
      }
    },
    "The office plans the job's phases on the web; they show here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Офис планирует этапы объекта в веб-версии; они появятся здесь."
          }
        }
      }
    },
    "The office verifies completed tasks." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполненные задачи проверяет офис."
          }
        }
      }
    },
    "The owner or office manages the account." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунтом управляет владелец или офис."
          }
        }
      }
    },
    "The PinPlan account %@ has been deleted and this device has been cleared." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт PinPlan %@ удалён, а это устройство очищено."
          }
        }
      }
    },
    "The server answered %lld. Check the address." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер ответил %lld. Проверьте адрес."
          }
        }
      }
    },
    "The terms, privacy policy and support pages open once this copy of PinPlan is connected (Settings › More › Advanced)." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия, политика конфиденциальности и страница поддержки откроются, когда эта копия PinPlan будет подключена (Настройки › Ещё › Дополнительно)."
          }
        }
      }
    },
    "Their name" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя"
          }
        }
      }
    },
    "Their signature is saved with your name as the person who collected it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подпись сохраняется вместе с вашим именем как получившего её."
          }
        }
      }
    },
    "Then change room, product, cables or closet for all of them at once." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем меняйте помещение, товар, кабели или шкаф сразу для всех."
          }
        }
      }
    },
    "Then tap the plan where it goes" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затем коснитесь нужного места на плане"
          }
        }
      }
    },
    "They can no longer open the team's jobs. Their photos and notes stay on the jobs." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот человек больше не сможет открывать объекты команды. Его фото и заметки останутся в объектах."
          }
        }
      }
    },
    "They open the link, or in the app go to Settings › Team and type the code. It works once and runs out in 14 days." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно открыть ссылку или в приложении перейти в Настройки › Команда и ввести код. Он срабатывает один раз и истекает через 14 дней."
          }
        }
      }
    },
    "They show first under New checklist on every job. Checklists already started from a template stay as they are." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они показываются первыми в «Новом чек-листе» на каждом объекте. Уже начатые по шаблону чек-листы не меняются."
          }
        }
      }
    },
    "They stay in the other account's cloud. Changes to them that were never synced are lost." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они останутся в облаке другого аккаунта. Несинхронизированные изменения в них будут потеряны."
          }
        }
      }
    },
    "Thick" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Толстая"
          }
        }
      }
    },
    "Thin" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тонкая"
          }
        }
      }
    },
    "This can't be undone. If you own a company team that still has other people on it, remove them (or hand the team over) first. Jobs that belong to someone else's team stay with that team. Export anything you want to keep before you continue." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это нельзя отменить. Если вы владелец команды компании, в которой есть другие люди, сначала удалите их (или передайте команду). Объекты чужой команды останутся в ней. Перед продолжением экспортируйте всё, что хотите сохранить."
          }
        }
      }
    },
    "This copy of PinPlan isn't connected to PinPlan accounts. Everything else works on this device without an account." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта копия PinPlan не подключена к аккаунтам PinPlan. Всё остальное работает на этом устройстве без аккаунта."
          }
        }
      }
    },
    "This copy of PinPlan isn't connected yet." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта копия PinPlan ещё не подключена."
          }
        }
      }
    },
    "This device has %lld jobs from another account (%@). To sync this account, remove them from this device first (they stay in the other account's cloud), or sign out." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве есть объекты другого аккаунта (%2$@): %1$lld. Чтобы синхронизировать этот аккаунт, сначала уберите их с устройства (они останутся в облаке другого аккаунта) или выйдите."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has %#@arg1@ from another account (%2$@). To sync this account, remove them from this device first (they stay in the other account's cloud), or sign out."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg job"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg jobs"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "This device has %lld jobs from another account. To sync this account, remove them from this device first (they stay in the other account's cloud), or sign out." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "На этом устройстве %lld объект другого аккаунта. Чтобы синхронизировать этот аккаунт, сначала уберите его с устройства (он останется в облаке другого аккаунта) или выйдите."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "На этом устройстве %lld объекта другого аккаунта. Чтобы синхронизировать этот аккаунт, сначала уберите их с устройства (они останутся в облаке другого аккаунта) или выйдите."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "На этом устройстве %lld объектов другого аккаунта. Чтобы синхронизировать этот аккаунт, сначала уберите их с устройства (они останутся в облаке другого аккаунта) или выйдите."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "На этом устройстве %lld объектов другого аккаунта. Чтобы синхронизировать этот аккаунт, сначала уберите их с устройства (они останутся в облаке другого аккаунта) или выйдите."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This device has %lld job from another account. To sync this account, remove them from this device first (they stay in the other account's cloud), or sign out."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This device has %lld jobs from another account. To sync this account, remove them from this device first (they stay in the other account's cloud), or sign out."
                }
              }
            }
          }
        }
      }
    },
    "This email already has an account — tap Sign in instead." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой почты уже есть аккаунт — нажмите «Войти»."
          }
        }
      }
    },
    "This email already has an account. Tap Sign in instead." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этой почты уже есть аккаунт. Нажмите «Войти»."
          }
        }
      }
    },
    "This email isn't confirmed yet. Open the confirmation email (check spam), then sign in." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта почта ещё не подтверждена. Откройте письмо с подтверждением (проверьте спам), затем войдите."
          }
        }
      }
    },
    "This file hasn't downloaded yet — it arrives with the next sync" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл ещё не загружен — он придёт со следующей синхронизацией"
          }
        }
      }
    },
    "This file hasn't downloaded yet — it arrives with the next sync." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
