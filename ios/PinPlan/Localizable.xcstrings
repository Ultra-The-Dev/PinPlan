    "To keep your account safe, enter your password again (or get a code by email), then delete your account." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proteger tu cuenta, escribe otra vez tu contraseña (o recibe un código por correo) y luego elimina tu cuenta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla bezpieczeństwa konta wpisz ponownie hasło (lub otrzymaj kod e-mailem), a potem usuń konto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para manter sua conta segura, digite sua senha de novo (ou receba um código por e-mail) e depois exclua sua conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы защитить аккаунт, введите пароль ещё раз (или получите код по email), затем удалите аккаунт."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб захистити акаунт, введіть пароль ще раз (або отримайте код на email), потім видаліть акаунт."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để bảo vệ tài khoản, hãy nhập lại mật khẩu (hoặc nhận mã qua email), rồi xóa tài khoản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为保护你的账户安全，请再次输入密码（或通过邮件获取验证码），然后删除账户。"
          }
        }
      }
    },
    "To sign in through this server, choose “Use my sign-in with this server” under Settings › More › Advanced first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para iniciar sesión a través de este servidor, primero elige “Usar mi inicio de sesión con este servidor” en Ajustes › Más › Avanzado."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby logować się przez ten serwer, najpierw wybierz „Użyj mojego logowania z tym serwerem” w Ustawienia › Więcej › Zaawansowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para entrar por este servidor, escolha primeiro “Usar meu login com este servidor” em Ajustes › Mais › Avançado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы входить через этот сервер, сначала выберите «Использовать мой вход с этим сервером» в «Настройки» › «Ещё» › «Дополнительно»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб входити через цей сервер, спершу виберіть «Використовувати мій вхід із цим сервером» у «Налаштування» › «Ще» › «Додатково»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để đăng nhập qua máy chủ này, trước tiên hãy chọn “Dùng đăng nhập của tôi với máy chủ này” trong Cài đặt › Thêm › Nâng cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要通过这台服务器登录，请先在 设置 › 更多 › 高级 中选择“在此服务器上使用我的登录”。"
          }
        }
      }
    },
