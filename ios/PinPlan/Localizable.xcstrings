          }
        }
      }
    },
    "This device has %lld jobs from another account (%@). To sync this account, remove them from this device first (they stay in the other account's cloud), or sign out." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device has %#@arg1@ from another account (%2$@). To sync this account, remove them from this device first (they stay in the other account's cloud), or sign out."
          },
          "substitutions" : {
            "arg1" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg job"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg jobs"
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tiene obras de otra cuenta (%2$@): %1$lld. Para sincronizar esta cuenta, primero quítalas de este dispositivo (se quedan en la nube de la otra cuenta) o cierra sesión."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym urządzeniu są zlecenia z innego konta (%2$@): %1$lld. Aby zsynchronizować to konto, najpierw usuń je z tego urządzenia (zostaną w chmurze drugiego konta) albo się wyloguj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo tem obras de outra conta (%2$@): %1$lld. Para sincronizar esta conta, primeiro remova-as deste dispositivo (elas continuam na nuvem da outra conta) ou saia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве есть объекты другого аккаунта (%2$@): %1$lld. Чтобы синхронизировать этот аккаунт, сначала уберите их с устройства (они останутся в облаке другого аккаунта) или выйдите."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому пристрої є об'єкти іншого акаунта (%2$@): %1$lld. Щоб синхронізувати цей акаунт, спершу приберіть їх із пристрою (вони залишаться в хмарі іншого акаунта) або вийдіть."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị này có %1$lld công trình của tài khoản khác (%2$@). Để đồng bộ tài khoản này, hãy gỡ chúng khỏi thiết bị này trước (chúng vẫn ở trên đám mây của tài khoản kia), hoặc đăng xuất."
