    "Too many emails sent — wait an hour, or sign in if the account already exists." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se enviaron demasiados correos: espera una hora, o inicia sesión si la cuenta ya existe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłano za dużo e-maili — odczekaj godzinę lub zaloguj się, jeśli konto już istnieje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E-mails demais enviados — espere uma hora, ou entre se a conta já existir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправлено слишком много писем — подождите час или войдите, если аккаунт уже есть."
          }
