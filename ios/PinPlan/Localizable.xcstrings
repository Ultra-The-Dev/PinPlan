    "Cables differ between these devices — a change replaces each device’s cables." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cables son distintos entre estos dispositivos — un cambio reemplaza los cables de cada dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te urządzenia mają różne kable — zmiana zastąpi kable każdego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cabos são diferentes entre estes dispositivos — uma alteração substitui os cabos de cada dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этих устройств разные кабели — изменение заменит кабели каждого устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цих пристроїв різні кабелі — зміна замінить кабелі кожного пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cáp của các thiết bị này khác nhau — thay đổi sẽ thay cáp của từng thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些设备的线缆不同 — 修改会替换每个设备的线缆。"
          }
        }
      }
    },
    "Camera finds the edges, straightens and cleans each page" : {
