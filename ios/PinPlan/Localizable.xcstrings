    "Nothing due today. Photos and your daily log keep the office in the loop." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada pendiente para hoy. Las fotos y tu bitácora diaria mantienen informada a la oficina."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na dziś nic. Zdjęcia i dziennik budowy informują biuro na bieżąco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada para hoje. As fotos e seu diário de obra mantêm o escritório informado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сегодня ничего. Фото и ежедневный отчёт держат офис в курсе."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На сьогодні нічого. Фото й щоденний журнал тримають офіс у курсі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay không có gì đến hạn. Ảnh và nhật ký hằng ngày giúp văn phòng nắm được tình hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天没有到期的事项。照片和施工日志能让办公室随时了解情况。"
          }
        }
      }
    },
