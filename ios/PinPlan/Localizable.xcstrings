    "Your company's Billdu keys stay on the Northpin server and never come to this device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de Billdu de tu empresa se quedan en el servidor de Northpin y nunca llegan a este dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze Billdu Twojej firmy pozostają na serwerze Northpin i nigdy nie trafiają na to urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves Billdu da sua empresa ficam no servidor Northpin e nunca vêm para este dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи Billdu вашей компании хранятся на сервере Northpin и не попадают на это устройство."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключі Billdu вашої компанії зберігаються на сервері Northpin і не потрапляють на цей пристрій."
          }
        },
        "vi" : {
          "stringUnit" : {
