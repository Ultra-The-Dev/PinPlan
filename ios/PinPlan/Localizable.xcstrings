    "%@ and prices are handled by the office. Your role on the team is Technician." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раздел «%@» и цены ведёт офис. Ваша роль в команде — монтажник."
          }
        }
      }
    },
    "%@ approved the layout. Next: price it and send the quote from Money." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: размещение утверждено. Далее: рассчитайте цену и отправьте смету из раздела «Финансы»."
          }
        }
      }
    },
    "%@ approved the quote — job approved" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
