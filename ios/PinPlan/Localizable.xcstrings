    "%@ asked for changes. Update the plan, then send an updated plan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pidió cambios. Actualiza el plano y luego envía el plano actualizado."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: zgłoszono zmiany. Zaktualizuj plan, a potem wyślij zaktualizowany plan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pediu alterações. Atualize a planta e envie a planta atualizada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: запрошены изменения. Обновите план и отправьте обновлённый план."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: запитано зміни. Оновіть план і надішліть оновлений план."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yêu cầu chỉnh sửa. Cập nhật bản vẽ rồi gửi lại bản vẽ mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@要求修改。请更新图纸，然后发送更新后的图纸。"
