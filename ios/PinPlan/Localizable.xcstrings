    "Take photos on site — they're stamped with the time, who took them and where, and sync to the web app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma fotos en la obra: se marcan con la hora, quién las tomó y dónde, y se sincronizan con la app web."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rób zdjęcia na budowie — dostają znacznik czasu, autora i miejsca i synchronizują się z wersją webową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire fotos na obra — elas recebem a hora, quem tirou e onde, e sincronizam com a versão web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Снимайте на объекте — к фото добавляются время, автор и место, и они синхронизируются с веб-версией."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімайте на об'єкті — до фото додаються час, автор і місце, і вони синхронізуються з веб-версією."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp ảnh tại công trình — ảnh được gắn thời gian, người chụp và vị trí, rồi đồng bộ lên bản web."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在现场拍照——照片会记录时间、拍摄人和地点，并同步到网页版。"
          }
        }
      }
    },
    "Tap + Task, then tap the plan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + Tarea y luego toca el plano."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij + Zadanie, a potem dotknij planu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em + Tarefa e depois na planta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «+ Задача», затем коснитесь плана."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть «+ Завдання», потім торкніться плану."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm + Việc, rồi chạm vào bản vẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点“+ 任务”，然后点图纸。"
          }
        }
      }
    },
    "Tap a device, the path, then a closet" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un dispositivo, la ruta y luego un cuarto de equipos"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij urządzenia, ścieżki, a potem szafy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um dispositivo, no caminho e depois em um armário"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь устройства, пути, затем шкафа"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться пристрою, шляху, потім шафи"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm một thiết bị, đường đi, rồi một tủ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依次点设备、路径，然后点设备间"
          }
        }
      }
    },
    "Tap again to move it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca otra vez para moverlo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij ponownie, aby przesunąć."
