    "Keep a short record of each day on site — crew, work done, issues, next steps — with that day’s photos." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva un registro breve de cada día en la obra — cuadrilla, trabajo hecho, problemas, siguientes pasos — con las fotos de ese día."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj krótko każdy dzień na budowie — ekipa, wykonane prace, problemy, kolejne kroki — ze zdjęciami z tego dnia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre um resumo de cada dia na obra — equipe, serviço feito, problemas, próximos passos — com as fotos do dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведите краткую запись каждого дня на объекте — бригада, сделанная работа, проблемы, следующие шаги — с фото за этот день."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ведіть короткий запис кожного дня на об'єкті — бригада, виконана робота, проблеми, наступні кроки — з фото за цей день."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại ngắn gọn mỗi ngày tại công trình — tổ thợ, việc đã làm, vấn đề, bước tiếp theo — kèm ảnh của ngày đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简要记录每天的现场情况 — 人员、完成的工作、问题、下一步 — 并附上当天的照片。"
          }
        }
      }
    },
    "Keep contracts, spec sheets, permits and manuals with the job (up to 25 MB each). They sync to the web app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda contratos, fichas técnicas, permisos y manuales con la obra (hasta 25 MB cada uno). Se sincronizan con la app web."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj umowy, karty katalogowe, pozwolenia i instrukcje razem ze zleceniem (do 25 MB każdy). Synchronizują się z wersją webową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde contratos, fichas técnicas, licenças e manuais com a obra (até 25 MB cada). Eles sincronizam com o app web."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните договоры, спецификации, разрешения и инструкции вместе с объектом (до 25 МБ каждый). Они синхронизируются с веб-версией."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте договори, специфікації, дозволи й інструкції разом з об'єктом (до 25 МБ кожен). Вони синхронізуються з веб-версією."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu hợp đồng, thông số kỹ thuật, giấy phép và hướng dẫn cùng công trình (tối đa 25 MB mỗi tệp). Chúng được đồng bộ lên ứng dụng web."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将合同、规格书、许可证和说明书与工程放在一起（每个最大 25 MB）。它们会同步到网页版。"
          }
        }
      }
    },
