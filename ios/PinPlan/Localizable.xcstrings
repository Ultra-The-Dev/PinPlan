    "%@ and prices are handled by the office. Your role on the team is Technician." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sección “%@” y los precios los maneja la oficina. Tu rol en el equipo es Técnico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekcją „%@” i cenami zajmuje się biuro. Twoja rola w zespole to Technik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e preços ficam com o escritório. Sua função na equipe é Técnico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Раздел «%@» и цены ведёт офис. Ваша роль в команде — монтажник."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розділ «%@» і ціни веде офіс. Ваша роль у команді — технік."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ và giá do văn phòng phụ trách. Vai trò của bạn trong nhóm là Kỹ thuật viên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@和价格由办公室负责。你在团队中的角色是技术员。"
          }
        }
      }
    },
    "%@ approved the layout. Next: price it and send the quote from Money." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aprobó la distribución. Siguiente: ponle precio y envía la cotización desde Dinero."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: rozmieszczenie zatwierdzone. Dalej: wyceń i wyślij wycenę z sekcji Finanse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aprovou o layout. Próximo passo: defina os preços e envie o orçamento pelo Financeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: размещение утверждено. Далее: рассчитайте цену и отправьте смету из раздела «Финансы»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: розміщення затверджено. Далі: розрахуйте ціну й надішліть кошторис із розділу «Фінанси»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã duyệt bố trí. Tiếp theo: tính giá và gửi báo giá từ mục Tài chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已确认布置图。下一步：在财务中定价并发送报价单。"
          }
        }
      }
    },
    "%@ approved the quote — job approved" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aprobó la cotización — obra aprobada"
