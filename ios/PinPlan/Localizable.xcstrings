        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Название команды"
          }
        }
      }
    },
    "Teams aren't switched on for this PinPlan server yet. Pull to refresh once it's updated." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды на этом сервере PinPlan пока не включены. Потяните вниз для обновления, когда сервер обновят."
          }
        }
      }
    },
    "Technicians take a photo before they can mark a device with these statuses." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монтажники делают фото, прежде чем отметить устройство этими статусами."
