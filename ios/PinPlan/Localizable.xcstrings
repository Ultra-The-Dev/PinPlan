    "An invite code saved on this device was for another sign-in, so it wasn't used. To join, enter the code under Settings › Team." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un código de invitación guardado en este dispositivo era para otra cuenta, así que no se usó. Para unirte, ingresa el código en Configuración › Equipo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod zaproszenia zapisany na tym urządzeniu dotyczył innego konta, więc nie został użyty. Aby dołączyć, wpisz kod w Ustawienia › Zespół."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um código de convite salvo neste aparelho era de outro login, então não foi usado. Para entrar na equipe, digite o código em Ajustes › Equipe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код приглашения, сохранённый на этом устройстве, был для другого аккаунта, поэтому он не использован. Чтобы присоединиться, введите код в «Настройки» › «Команда»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код запрошення, збережений на цьому пристрої, був для іншого облікового запису, тому його не використано. Щоб приєднатися, введіть код у «Налаштування» › «Команда»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã mời lưu trên thiết bị này thuộc về một lần đăng nhập khác nên không được dùng. Để vào nhóm, nhập mã trong Cài đặt › Nhóm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上保存的邀请码属于另一个登录账户，因此未使用。要加入，请在“设置 › 团队”中输入代码。"
          }
        }
      }
    },
    "An owner or admin connects Billdu in Northpin on the web, under Settings › Billdu." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
