    "The terms, privacy policy and support pages open once this copy of Northpin is connected (Settings › More › Advanced)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los términos, la política de privacidad y las páginas de soporte se abren cuando esta copia de Northpin está conectada (Ajustes › Más › Avanzado)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warunki, polityka prywatności i strona pomocy otworzą się, gdy ta kopia Northpin zostanie połączona (Ustawienia › Więcej › Zaawansowane)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os termos, a política de privacidade e as páginas de suporte abrem quando esta cópia do Northpin estiver conectada (Ajustes › Mais › Avançado)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Условия, политика конфиденциальности и страница поддержки откроются, когда эта копия Northpin будет подключена (Настройки › Ещё › Дополнительно)."
          }
        },
        "uk" : {
