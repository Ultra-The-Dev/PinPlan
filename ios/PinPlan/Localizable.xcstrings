    "Jobs already on this device are replaced by the backup's copy." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las obras que ya están en este dispositivo se reemplazan por la copia del respaldo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlecenia, które już są na tym urządzeniu, zostaną zastąpione kopią z kopii zapasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As obras que já estão neste aparelho são substituídas pela cópia do backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объекты, которые уже есть на этом устройстве, заменяются копией из резервной копии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об'єкти, які вже є на цьому пристрої, замінюються копією з резервної копії."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công trình đã có trên thiết bị này sẽ bị thay bằng bản trong bản sao lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上已有的工程会被备份中的副本替换。"
          }
        }
      }
    },
    "Jobs already on this device come in as copies; the originals stay as they are." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las obras que ya están en este dispositivo entran como copias; las originales quedan como están."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zlecenia, które już są na tym urządzeniu, zostaną dodane jako kopie; oryginały pozostaną bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As obras que já estão neste aparelho entram como cópias; as originais ficam como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объекты, которые уже есть на этом устройстве, добавляются как копии; оригиналы остаются без изменений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Об'єкти, які вже є на цьому пристрої, додаються як копії; оригінали лишаються без змін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công trình đã có trên thiết bị này sẽ được nhập dưới dạng bản sao; bản gốc giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上已有的工程会以副本形式导入；原工程保持不变。"
          }
        }
      }
    },
    "Jobs are read-only" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las obras son de solo lectura"
