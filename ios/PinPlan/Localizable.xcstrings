    "Clients can pay invoices by card from their link once the office connects Stripe on the web: Settings → Quotes & invoices → Online payments." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clientes pueden pagar las facturas con tarjeta desde su enlace cuando la oficina conecte Stripe en la web: Configuración → Cotizaciones y facturas → Pagos en línea."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klienci mogą płacić faktury kartą ze swojego linku, gdy biuro połączy Stripe w wersji webowej: Ustawienia → Wyceny i faktury → Płatności online."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os clientes podem pagar faturas com cartão pelo link quando o escritório conectar o Stripe na versão web: Configurações → Orçamentos e faturas → Pagamentos on-line."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиенты смогут оплачивать счета картой по своей ссылке, когда офис подключит Stripe в веб-версии: Настройки → Сметы и счета → Онлайн-оплата."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клієнти зможуть оплачувати рахунки карткою за своїм посиланням, коли офіс під’єднає Stripe у веб-версії: Налаштування → Кошториси й рахунки → Онлайн-оплата."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khách hàng có thể thanh toán hóa đơn bằng thẻ từ liên kết của họ sau khi văn phòng kết nối Stripe trên web: Cài đặt → Báo giá & hóa đơn → Thanh toán trực tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "办公室在网页版连接 Stripe 后，客户即可通过链接用银行卡支付发票：设置 → 报价单和发票 → 在线支付。"
          }
        }
      }
    }
  },
  "version" : "1.0"
