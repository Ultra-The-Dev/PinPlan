    "Create a job, add its plans (PDF, photos or the document scanner), then tap to place devices, wire runs and panels." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una obra, agrega sus planos (PDF, fotos o el escáner de documentos) y luego toca para colocar dispositivos, tendidos y tableros."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz zlecenie, dodaj plany (PDF, zdjęcia lub skaner dokumentów), a potem stukaj, aby umieszczać urządzenia, trasy kablowe i rozdzielnice."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
