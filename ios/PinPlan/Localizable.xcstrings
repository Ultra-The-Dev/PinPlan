    "You can keep using Northpin on this device without an account, or create a new one any time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes seguir usando Northpin en este dispositivo sin cuenta, o crear una nueva cuando quieras."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz dalej korzystać z Northpin na tym urządzeniu bez konta albo w każdej chwili utworzyć nowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode continuar usando o Northpin neste dispositivo sem conta, ou criar uma nova quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете пользоваться Northpin на этом устройстве без аккаунта или в любой момент создать новый."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви можете користуватися Northpin на цьому пристрої без акаунта або будь-коли створити новий."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể tiếp tục dùng Northpin trên thiết bị này mà không cần tài khoản, hoặc tạo tài khoản mới bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在这台设备上不用账户继续使用 Northpin，也可以随时创建新账户。"
          }
        }
      }
    },
    "You joined %@ as %@." : {
      "localizations" : {
