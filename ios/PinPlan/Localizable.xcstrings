    "Items with a camera badge need a photo before they count as done. Long-press an item to change that." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos con el ícono de cámara necesitan una foto para contar como terminados. Mantén presionado un punto para cambiarlo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty z ikoną aparatu wymagają zdjęcia, zanim zostaną uznane za wykonane. Przytrzymaj punkt, aby to zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itens com o ícone de câmera precisam de foto para contar como feitos. Toque e segure um item para mudar isso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пункты со значком камеры засчитываются только с фото. Нажмите и удерживайте пункт, чтобы изменить это."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пункти зі значком камери зараховуються лише з фото. Натисніть і утримуйте пункт, щоб змінити це."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục có biểu tượng máy ảnh cần có ảnh mới được tính là xong. Nhấn giữ một mục để đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "带相机标志的项目需要照片才算完成。长按项目可更改此设置。"
          }
        }
      }
    },
