    "Make quotes and invoices on the web, and sign in to cloud sync to see them here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz cotizaciones y facturas en la web, e inicia sesión en la sincronización en la nube para verlas aquí."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórz wyceny i faktury w wersji webowej i zaloguj się do synchronizacji z chmurą, aby widzieć je tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça orçamentos e faturas na web e entre na sincronização na nuvem para vê-los aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создавайте сметы и счета в веб-версии и войдите в облачную синхронизацию, чтобы видеть их здесь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створюйте кошториси й рахунки у веб-версії та увійдіть у хмарну синхронізацію, щоб бачити їх тут."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo báo giá và hóa đơn trên web, rồi đăng nhập đồng bộ đám mây để xem tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在网页版创建报价单和发票，并登录云同步后在此查看。"
          }
        }
      }
    },
    "Make quotes and invoices on the web. They show up here after the next sync." : {
