    "The client reviews the plans and price, picks options and signs online." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cliente revisa los planos y el precio, elige opciones y firma en línea."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klient przegląda plany i cenę, wybiera opcje i podpisuje online."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cliente revisa as plantas e o preço, escolhe opcionais e assina online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клиент смотрит планы и цену, выбирает опции и подписывает онлайн."
