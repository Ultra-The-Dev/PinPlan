    "Teams aren't switched on for this Northpin server yet. Pull to refresh once it's updated." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los equipos aún no están activados en este servidor de Northpin. Desliza hacia abajo para actualizar cuando se actualice."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zespoły nie są jeszcze włączone na tym serwerze Northpin. Pociągnij w dół, aby odświeżyć po jego aktualizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As equipes ainda não estão ativadas neste servidor Northpin. Puxe para atualizar quando ele for atualizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды на этом сервере Northpin пока не включены. Потяните вниз для обновления, когда сервер обновят."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команди на цьому сервері Northpin ще не ввімкнено. Потягніть униз для оновлення, коли сервер оновлять."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng nhóm chưa được bật trên máy chủ Northpin này. Kéo xuống để làm mới sau khi máy chủ được cập nhật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Northpin 服务器还没开通团队功能。服务器更新后下拉刷新。"
          }
        }
      }
    },
    "Technicians take a photo before they can mark a device with these statuses." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los técnicos toman una foto antes de poder marcar un dispositivo con estos estados."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technicy robią zdjęcie, zanim oznaczą urządzenie tymi statusami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os técnicos tiram uma foto antes de poder marcar um dispositivo com estes status."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монтажники делают фото, прежде чем отметить устройство этими статусами."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Техніки роблять фото, перш ніж позначити пристрій цими статусами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kỹ thuật viên phải chụp ảnh trước khi đánh dấu thiết bị với các trạng thái này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技术员必须先拍照，才能把设备标记为这些状态。"
          }
        }
      }
