    "Take a photo on site with location on, or set the location on the job’s Job tab." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma una foto en la obra con la ubicación activada, o fija la ubicación en la pestaña Obra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób zdjęcie na budowie z włączoną lokalizacją lub ustaw lokalizację na karcie Zlecenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire uma foto na obra com a localização ativada, ou defina a localização na aba Obra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сделайте фото на объекте с включённой геопозицией или задайте расположение во вкладке «Объект»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зробіть фото на об'єкті з увімкненою геолокацією або задайте розташування на вкладці «Об'єкт»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp ảnh tại công trình khi bật định vị, hoặc đặt vị trí trong tab Công trình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在现场打开定位后拍一张照片，或在工程的“工程”标签页设置位置。"
          }
        }
      }
    },
    "Take photo" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomar foto"
          }
        },
        "pl" : {
