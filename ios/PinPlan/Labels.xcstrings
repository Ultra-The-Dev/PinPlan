    "Field work on every job: plans, devices, photos, checklists, logs and tasks. No prices." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabajo de campo en todas las obras: planos, dispositivos, fotos, listas de verificación, bitácoras y tareas. Sin precios."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prace w terenie przy każdym zleceniu: plany, urządzenia, zdjęcia, listy kontrolne, dzienniki i zadania. Bez cen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
