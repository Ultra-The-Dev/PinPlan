# PinPlan environment variables. Copy to .env.local for local work; on Vercel add them under
# Settings -> Environment Variables. Keep every value in this file empty (examples are in comments) and never
# commit real keys: this repo is public.
#
# Without any values the web app runs local-only (data stays in the browser).
# A paid production deployment needs every variable marked REQUIRED: /api/health answers 503 and the server logs one
# "PRODUCTION CONFIG INCOMPLETE" line naming what's missing until they are set.
# NEXT_PUBLIC_* values are built into the browser code: set them before the build and redeploy after changing them.
# Everything else is server-only: never give a secret a NEXT_PUBLIC_ name.
# The order to set things up in: docs/launch-checklist.md. Step-by-step setup: SETUP.md.

# ---------------------------------------------------------------------------------------------------------------
# App address
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED. The https address of the app. Used for links in emails, Stripe checkout and portal return addresses, the
# accounting-app sign-in redirects and the billing cron. Must start with https:// in production.
# Example: https://<your-domain>
PINPLAN_APP_URL=
# Recommended. The public address for canonical links, the sitemap, robots.txt and link previews (falls back to
# PINPLAN_APP_URL, then the website in src/lib/legal.ts). Example: https://<your-domain>
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------------------------------------------
# Supabase (accounts, companies, sync, plan and photo storage)
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED. Supabase -> Project Settings -> API. Public by design: row-level security keeps each company's data private.
# Example: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# REQUIRED. Server-only. Account deletion, the Stripe webhook, email checks, invites, /admin and encrypted secrets.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------------------------------------------
# Encryption of stored credentials (Billdu, QuickBooks Online, Xero)
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED. 32-byte key, base64 or hex. Generate: openssl rand -base64 32   Keep a copy in your password manager:
# losing or changing it disconnects every company's connected apps.
PINPLAN_ENCRYPTION_KEY=
# Only while rotating: the old key, so stored credentials can still be read and re-saved with the new one.
# Remove it once every company has used or re-saved its connections.
PINPLAN_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------------------------------------------
# Billing (Stripe). Server-only.
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED. Stripe -> Developers -> API keys (sk_live_... in production, sk_test_... while testing).
STRIPE_SECRET_KEY=
# REQUIRED. Signing secret of the webhook endpoint https://<your-domain>/api/billing/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# REQUIRED. Price IDs (price_...): the flat monthly base price, and the monthly price per extra user.
STRIPE_PRICE_BASE=
STRIPE_PRICE_SEAT=
# Optional. 1 = Stripe Tax on checkout (turn Stripe Tax on and add your registrations in Stripe first).
STRIPE_TAX=
# Optional. 1 = customers must tick "I agree to the Terms of Service" at checkout (set the Terms URL under
# Stripe -> Settings -> Public details first, or checkout fails).
STRIPE_TERMS_CONSENT=

# ---------------------------------------------------------------------------------------------------------------
# Online invoice payments (Stripe Connect). Server-only. Optional: off and invisible in the apps until set.
# Companies connect their own Stripe account (Settings -> Quotes & invoices -> Online payments) and clients pay
# invoices by card from the client link; the money goes to the company's account, never the platform's.
# Also needs STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY and PINPLAN_APP_URL. Setup: docs/payments.md.
# ---------------------------------------------------------------------------------------------------------------
# Signing secret (whsec_...) of a SECOND webhook endpoint, https://<your-domain>/api/payments/webhook, created with
# "Listen to: Events on Connected accounts" (not your own account). Setting it turns online payments on.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional. Platform fee on each online payment, in basis points (100 = 1%), whole number 0-1000. Empty or 0 = no fee.
PINPLAN_PAYMENTS_FEE_BPS=
# REQUIRED for trial reminders and payment-failed emails. A long random string; Vercel Cron sends it as a Bearer token
# to /api/cron/billing-reminders (schedule in vercel.json). Generate: openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Email (Resend). Server-only.
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED. Resend -> API Keys, "Sending access" limited to your sending domain (re_...).
RESEND_API_KEY=
# REQUIRED. Sender on the domain verified in Resend. Example: PinPlan <noreply@mail.<your-domain>>
EMAIL_FROM=
# Optional. Where replies go. Example: support@<your-domain>
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------------------------------------------
# Operations. Server-only.
# ---------------------------------------------------------------------------------------------------------------
# Comma-separated emails allowed into /admin (must be confirmed accounts). Keep real addresses out of git.
PLATFORM_ADMIN_EMAILS=
# Optional. Version string on error reports (defaults to the Vercel commit, when Vercel exposes system variables).
NEXT_PUBLIC_APP_VERSION=
# Optional. 1 = send the Content-Security-Policy as report-only. Only to debug a CSP problem; leave unset.
CSP_REPORT_ONLY=
# Build-time. strict = the build (prebuild, scripts/check-legal.mjs) FAILS while src/lib/legal.ts or
# public/.well-known/security.txt still has a [placeholder] or security.txt has expired. Unset = warn only. Set it to
# strict in Vercel's Production environment once `npm run check:legal` lists nothing (launch-checklist.md step 2.2).
LEGAL_CHECK=
# Server. production = this deployment is production (required settings are checked, open mode is refused). Set by
# wrangler.jsonc on Cloudflare Workers; on Vercel leave unset (VERCEL_ENV says it). Any other value = not production.
PINPLAN_ENV=
# Server. Leave unset on Cloudflare Workers (the caller's IP comes from cf-connecting-ip) and on Vercel (VERCEL_ENV
# says it). 1 = this server sits behind your own proxy that overwrites X-Forwarded-For, so per-IP limits may read it.
# Never set it where callers reach the server directly: they could then pick their own IP and dodge every limit.
PINPLAN_TRUST_XFF=

# ---------------------------------------------------------------------------------------------------------------
# Sign-up protection (Cloudflare Turnstile). TURNSTILE_SECRET_KEY is required in production (/api/health answers 503
# without it); optional elsewhere.
# ---------------------------------------------------------------------------------------------------------------
# Site key (public, needed at build time: it also opens the CSP for challenges.cloudflare.com) and secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional. Terms version saved when someone joins a company with an invite code and the page doesn't say which
# (default 2026-11).
PINPLAN_TERMS_VERSION=

# ---------------------------------------------------------------------------------------------------------------
# Map tiles for the jobs map (Leaflet). Needed for a commercial launch: without them the map uses OpenStreetMap's
# public tiles, which their usage policy doesn't allow for a commercial app. Public (browser) values.
# ---------------------------------------------------------------------------------------------------------------
# A Leaflet URL template, e.g. https://<tile-provider>/{z}/{x}/{y}.png?key={key}
NEXT_PUBLIC_MAP_TILE_URL=
# Browser key for the provider: restrict it to your domain in the provider's dashboard.
NEXT_PUBLIC_MAP_TILE_KEY=
# Attribution text the provider requires, e.g. "© <provider> © OpenStreetMap contributors".
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# ---------------------------------------------------------------------------------------------------------------
# Weather on daily logs. Needed for a commercial launch: without these, requests go to Open-Meteo's free API, which
# is for non-commercial use only.
# ---------------------------------------------------------------------------------------------------------------
# Production: /api/weather (through this server, which adds OPEN_METEO_API_KEY), or the https:// origin of a
# self-hosted Open-Meteo.
NEXT_PUBLIC_WEATHER_URL=
# Server-only. Your Open-Meteo commercial API key (never NEXT_PUBLIC_). With it set, /api/weather answers only
# signed-in people (each request is paid for), with limits counted in the database (needs SUPABASE_SERVICE_ROLE_KEY).
OPEN_METEO_API_KEY=

# ---------------------------------------------------------------------------------------------------------------
# iPad and iPhone app
# ---------------------------------------------------------------------------------------------------------------
# Optional. The App Store listing (https://apps.apple.com/...). Until it's set, /start suggests Add to Home Screen.
NEXT_PUBLIC_APP_STORE_URL=

# ---------------------------------------------------------------------------------------------------------------
# Accounting apps (Beta). Optional: until the keys are set, both show "Not available yet". Export for accountant
# (QuickBooks Online CSV, Xero CSV, QuickBooks Desktop IIF) works without them. Server-only.
# ---------------------------------------------------------------------------------------------------------------
# Intuit developer app. Redirect URI: https://<your-domain>/api/integrations/quickbooks/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# sandbox while you use development keys; leave unset for production keys.
QBO_ENVIRONMENT=
# Xero app. Redirect URI: https://<your-domain>/api/integrations/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Only if Xero gives the app granular scopes (space-separated). Leave unset otherwise.
XERO_SCOPES=

# ---------------------------------------------------------------------------------------------------------------
# Billdu. Each company connects its own account in Settings -> Connected apps (stored encrypted). The server-wide
# keys below serve only your own company (PINPLAN_FOUNDER_TEAM_ID) or a single-company server. Optional.
# ---------------------------------------------------------------------------------------------------------------
# Your own company's team id (teams table). Only that company may use BILLDU_API_KEY / BILLDU_API_SECRET.
PINPLAN_FOUNDER_TEAM_ID=
BILLDU_API_KEY=
BILLDU_API_SECRET=
# Optional: a different Billdu API host (for example a mock for testing).
BILLDU_HOST=

# ---------------------------------------------------------------------------------------------------------------
# Self-host / single company only. Leave ALL of these unset on the hosted SaaS.
# ---------------------------------------------------------------------------------------------------------------
# A shared team access code for servers without Supabase accounts. With Supabase configured it is ignored unless
# PINPLAN_ALLOW_ACCESS_CODE=1. Never on a multi-company server.
PINPLAN_ACCESS_CODE=
# 1 = accept PINPLAN_ACCESS_CODE alongside Supabase sign-in (single-company server, or older iPad builds).
PINPLAN_ALLOW_ACCESS_CODE=
# 1 = a production server with neither Supabase nor an access code is meant to be open (otherwise protected routes
# answer 503). Only for a private, single-user server.
PINPLAN_ALLOW_OPEN=
# Directory for the encrypted secrets file when there's no SUPABASE_SERVICE_ROLE_KEY (default ./.data).
PINPLAN_DATA_DIR=

# iPhone/iPad "new version" banner (/api/ios/latest, docs/testflight.md). Optional: by default the newest build is read
# from the public "iOS TestFlight" workflow runs of IOS_RELEASE_REPO (owner/name, default the Northpin repository).
# IOS_LATEST_BUILD pins the build number instead (e.g. to hold the banner back).
IOS_RELEASE_REPO=
IOS_LATEST_BUILD=

# ---------------------------------------------------------------------------------------------------------------
# AI features: OFF for launch. Leave ALL of these unset.
# ---------------------------------------------------------------------------------------------------------------
# Turning AI on also changes the legal pages (an AI section and a new subprocessor). Don't, without a new review.
NEXT_PUBLIC_AI_ENABLED=
AI_ENABLED=
ANTHROPIC_API_KEY=
# The model id to use if AI is ever turned on (there is no built-in default).
ANTHROPIC_MODEL=

# Tests only (never in Vercel): PLAYWRIGHT_BASE_URL, E2E_PORT and CI for `npm run e2e`; BASE for scripts/e2e-*.cjs;
# PINPLAN_TEST_DB and PG* for scripts/test-supabase.sh.

# Set by Vercel automatically, don't add them yourself: VERCEL_ENV, VERCEL_REGION, VERCEL_PROJECT_PRODUCTION_URL,
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA (turn on "Automatically expose System Environment Variables").
