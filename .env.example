# Copy to .env.local and fill in. Every value is optional: without them the app runs local-only.

# --- Supabase (accounts, team sharing, plan image storage, sync) ---
# Project Settings -> API. Run supabase/migrations/*.sql against the project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI scan assist (server-side only) ---
ANTHROPIC_API_KEY=
# Optional model override for the vision scan.
ANTHROPIC_MODEL=

# --- Server-side secret storage ---
# 32-byte key (base64 or hex) used to encrypt the Billdu key/secret at rest.
# Generate: openssl rand -base64 32
PINPLAN_ENCRYPTION_KEY=
# Directory for the encrypted secrets file (default: ./.data). Use persistent storage in production.
PINPLAN_DATA_DIR=

# --- Billdu (optional; otherwise paste them in Settings -> Billdu) ---
# Billdu -> Settings -> API. Only the account owner can see these.
BILLDU_API_KEY=
BILLDU_API_SECRET=
# Optional: point at a different Billdu API host (e.g. a mock for testing).
BILLDU_HOST=
