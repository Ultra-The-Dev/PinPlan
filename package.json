{
  "name": "pinplan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-legal.mjs",
    "build": "next build",
    "postbuild": "node scripts/build-sw.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "test:db": "scripts/test-supabase.sh",
    "check:legal": "LEGAL_CHECK=strict node scripts/check-legal.mjs",
    "e2e": "playwright test",
    "check:migrations": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/leaflet": "^1.9.12",
    "dexie": "^4.4.7",
    "heic2any": "^0.0.4",
    "konva": "^10.9.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.72.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "^19.3.2",
    "stripe": "^23.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "playwright-core": "$@playwright/test"
  }
}
